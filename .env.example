# Copy to .env and adjust. Every value here has a working default, so .env is
# optional unless you want to change where Ollama lives or what it runs.

# --- Ollama ---------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Exploration ----------------------------------------------------------
# START_URL is only needed if you would rather not pass --url every time.
# START_URL=https://demo.realworld.io
MAX_STEPS=12

# Cap on console lines pulled into the prompt after an action.
MAX_CONSOLE_LINES=15

# --- Playwright MCP -------------------------------------------------------
# Browser the MCP server drives. "chromium" uses the build from
# `playwright install chromium`, so no system browser is required.
# Other accepted values: chrome, msedge, firefox, webkit.
MCP_BROWSER=chromium

# Passed verbatim to the MCP server. Useful examples:
#   MCP_ARGS=--viewport-size=1280,800
#   MCP_ARGS=--ignore-https-errors
# MCP_ARGS=
