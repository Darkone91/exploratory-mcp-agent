# Dependencies
node_modules/

# Run output. Each run writes a timestamped folder here; they are regenerated by
# running the agent, so they are not source. A curated run is kept in examples/.
runs/

# Playwright MCP scratch directory, created in the working directory at runtime.
.playwright-mcp/

# Local configuration
.env

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log
